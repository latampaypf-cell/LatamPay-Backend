# ====================================================================
# LatamPay - Configuración de Variables de Entorno
# ====================================================================

# Puerto en el que correrá el servidor localmente (ej: 3000)
PORT=3000

# Entorno de ejecución: 
# - 'development': Para trabajar en tu computadora.
# - 'production': Para cuando subas el código a Railway/Vercel.
NODE_ENV=development

# URL de conexión a tu base de datos PostgreSQL.
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/latampay_db

# Llave secreta para firmar los Tokens JWT (mínimo 32 caracteres).
# ¡Cámbiala por algo difícil de adivinar en producción!
JWT_SECRET=cambia_esto_por_uno_de_minimo_32_caracteres_random

# URL de tu aplicación Frontend (usada para permitir conexiones CORS).
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------------
# CONFIGURACIÓN DE SWAGGER (DOCUMENTACIÓN)
# --------------------------------------------------------------------
# Esta variable le dice a Swagger dónde está tu servidor para poder probar los endpoints.
# - EN LOCAL: Usa 'http://localhost:3000'.
# - EN PRODUCCIÓN: Pon la URL de tu backend (ej: https://latampay-api.up.railway.app).
#   Si no la pones, Swagger intentará conectarse a localhost y dará error en la nube.
SERVER_URL=http://localhost:3000

# --------------------------------------------------------------------
# SERVICIOS EXTERNOS
# --------------------------------------------------------------------
# API Key necesaria para obtener las tasas de cambio reales (ARS, COP, VES).
# Puedes obtener una gratis en: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=tu_api_key_aqui
